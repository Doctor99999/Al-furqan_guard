# =========================================================================
# Al-Furqan AI - Production Environment Template
# Copy to .env for local dev. On Render set these as service Environment Variables.
# NEVER commit real secrets. Values marked [REQUIRED] must be set for production.
# =========================================================================

# --- Core secrets (REQUIRED in production) ---------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Shared webhook secret. Set a FIXED stable value for production:
# it is auto-randomized on each start if left empty, which rotates the Telegram
# webhook secret on every deploy/restart.
TELEGRAM_WEBHOOK_SECRET=
# Chat ID(s) to receive new-feedback notifications (e.g. 123456789)
TELEGRAM_ADMIN_CHAT_ID=
# Admin key protecting GET /api/v1/feedback/list (X-Admin-Key header) [REQUIRED]
ADMIN_API_KEY=
# Salt used to hash client IPs for analytics. Set a FIXED value so unique-visitor
# counts stay stable across restarts. Auto-random if empty.
IP_HASH_SECRET=

# --- Optional integrations --------------------------------------------------
# Comma-separated allowed browser origins for CORS. Empty = same-origin only:
# CORS_ORIGINS=https://your-domain.app, https://admin.example.com
CORS_ORIGINS=
# PostgreSQL URL (Render Postgres). If set, analytics use Postgres instead of SQLite:
# DATABASE_URL=postgresql://user:pass@host:5432/alfurqan
DATABASE_URL=
# Live B2B master key. When set, a hashed demo partner org is seeded on startup.
# When left empty, NO default B2B key exists — keys are only what you provision.
B2B_DEMO_API_KEY=

# --- Runtime / infra --------------------------------------------------------
# Writable directory for SQLite DB, B2B keys and feedback. On Render point at a
# mounted persistent Disk (e.g. /var/lib/alfurqan) so state survives deploys.
RUNTIME_DATA_DIR=
# Set to 1 behind a trusted reverse proxy that provides X-Forwarded-For
# (Render sets this automatically via RENDER_EXTERNAL_URL).
TRUST_PROXY_HEADERS=
# Log level: INFO / DEBUG / WARNING. Debug leaks more detail in logs only.
LOG_LEVEL=INFO
# Web server bind
HOST=0.0.0.0
PORT=8000
# Render injects this automatically on Render.com
RENDER_EXTERNAL_URL=